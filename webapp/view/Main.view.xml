<mvc:View controllerName="com.br.fiori.teaminsightplatform.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:forms="sap.ui.layout.form"
    xmlns:m="sap.m"
    height="100%">
    <m:Page id="page" showFooter="true" showSubHeader="true" titleAlignment="Center" title="{i18n>title}">
        <ObjectPageLayout id="idObjectPageLayout" upperCaseAnchorBar="false">
            <headerTitle>
                <ObjectPageDynamicHeaderTitle>
                    <heading>
                        <m:Title text="Gerenciamento de Feedback" titleStyle="H2" wrapping="true"/>
                    </heading>
                    <snappedTitleOnMobile>
                        <m:Title text="Feedback"/>
                    </snappedTitleOnMobile>
                </ObjectPageDynamicHeaderTitle>
            </headerTitle>
            <headerContent>
                <m:Title text="Controle de Resultados, Feedbacks e Cultura Organizacional  " titleStyle="H4"/>
            </headerContent>
            <sections>
                <ObjectPageSection titleUppercase="false" id="section1" title="Section 1">
                    <subSections>
                        <ObjectPageSubSection id="section1_SS1" title="Subsection 1.1 " titleUppercase="false">
                            <blocks>
                                <m:GenericTile header="{title}"
                                    subheader="{subtitle}"
                                    state="{=${state} || 'Loaded'}"
                                    scope="{/scope}"
                                    press="press"
                                    class="sapUiTinyMarginEnd"
                                    sizeBehavior="{/sizeBehavior}">
                                    <m:TileContent unit="{unit}" footer="{footer}">
                                        <m:NumericContent withMargin="false"
                                            value="{kpivalue}"
                                            valueColor="{color}"
                                            indicator="{trend}"
                                            scale="{scale}"/>
                                    </m:TileContent>
                                </m:GenericTile>
                            </blocks>
                        </ObjectPageSubSection>
                        <ObjectPageSubSection id="section1_SS2" title="Subsection 1.2 ">
                            <blocks>
                                <forms:SimpleForm
                                    maxContainerCols="2"
                                    layout="ResponsiveGridLayout"
                                    editable="false">
                                    <m:Label text="Content"/>
                                    <m:Text text="some content goes here..."/>
                                </forms:SimpleForm>
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
                <ObjectPageSection titleUppercase="false" id="section2" title="Section 2">
                </ObjectPageSection>
                <ObjectPageSection titleUppercase="false" id="section3" title="Section 3">
                    <subSections>
                        <ObjectPageSubSection id="section3_SS1" title=" " titleUppercase="false">
                            <blocks>
                                <forms:SimpleForm
                                    maxContainerCols="2"
                                    layout="ResponsiveGridLayout"
                                    editable="false">
                                    <m:RangeSlider showAdvancedTooltip="true" min="0" max="10" width="80%" step="1"  class="sapUiMediumMarginBottom" />
                                </forms:SimpleForm>
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
                <ObjectPageSection titleUppercase="false" id="section4" title="Section 4">
                    <subSections>
                        <ObjectPageSubSection id="section4_SS1" title="Nível " titleUppercase="false">
                            <blocks>
                                <m:SegmentedButton selectedKey="mb">
                                    <m:items>
                                        <m:SegmentedButtonItem text="Muito Baixo" key="mb" />
                                        <m:SegmentedButtonItem text="Baixo" />
                                        <m:SegmentedButtonItem text="Médio" />
                                        <m:SegmentedButtonItem text="Alto" />
                                        <m:SegmentedButtonItem text="Excelente" />
                                    </m:items>
                                </m:SegmentedButton>
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
                <ObjectPageSection titleUppercase="false" id="section5" title="Section 5">
                    <subSections>
                        <ObjectPageSubSection id="section5_SS1" title=" " titleUppercase="false">
                            <blocks>
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
                <ObjectPageSection titleUppercase="false" id="section6" title="Section 6">
                    <subSections>
                        <ObjectPageSubSection id="section6_SS1" title=" " titleUppercase="false">
                            <blocks>
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
                <ObjectPageSection titleUppercase="false" id="section7" title="Section 7">
                    <subSections>
                        <ObjectPageSubSection id="section7_SS1" title=" " titleUppercase="false">
                            <blocks>
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
            </sections>
        </ObjectPageLayout>
    </m:Page>
</mvc:View>