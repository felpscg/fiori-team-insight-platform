<mvc:View controllerName="com.br.fiori.teaminsightplatform.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" showFooter="true" showSubHeader="true" titleAlignment="Center" title="{i18n>title}">
    <HBox class="sapUiLargeMarginTop ">
    <GenericTile class="sapUiLargeMarginBegin sapUiTinyMarginTop tileLayout" header="Cumulative Totals" subheader="Expenses" press="onPressTest">
		<TileContent unit="Unit" footer="Footer Text">
			<NumericContent value="1762" icon="sap-icon://line-charts" withMargin="false" />
		</TileContent>
	</GenericTile>
    <GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Right click to open in new tab"
		subheader="Link tile" press="press">
		<TileContent>
			<ImageContent src="test-resources/sap/m/demokit/sample/GenericTileAsLaunchTile/images/SAPLogoLargeTile_28px_height.png" />
		</TileContent>
	</GenericTile>
    	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Right click to open in new tab"
		subheader="Link tile" press="press">
		<TileContent>
			<ImageContent src="test-resources/sap/m/demokit/sample/GenericTileAsLaunchTile/images/SAPLogoLargeTile_28px_height.png" />
		</TileContent>
	</GenericTile>
    	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Right click to open in new tab"
		subheader="Link tile" press="press">
		<TileContent>
			<ImageContent src="test-resources/sap/m/demokit/sample/GenericTileAsLaunchTile/images/SAPLogoLargeTile_28px_height.png" />
		</TileContent>
	</GenericTile>
    <GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="US Profit Margin" press="onPress" frameType = "OneByHalf">
		<TileContent unit="Unit">
			<NumericContent scale="%" value="12" valueColor="Critical" indicator="Up" withMargin="false" />
		</TileContent>
	</GenericTile>
    </HBox>
    
    </Page>
</mvc:View>